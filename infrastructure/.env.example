# SkillTwin environment configuration example
# Copy to .env for local runtime settings

NODE_ENV=development
PORT=4000

# AWS settings for future deployment phases
AWS_REGION=ap-south-1
SKILLTWIN_ASSETS_BUCKET=skilltwin-assets-dev
SKILLTWIN_PIPELINE_ARN=arn:aws:states:ap-south-1:123456789012:stateMachine:skilltwin-pipeline-dev
DYNAMODB_TABLE_SKILLS=skilltwin-skills-dev
DYNAMODB_TABLE_JOBS=skilltwin-jobs-dev
DYNAMODB_TABLE_SESSIONS=skilltwin-sessions-dev
