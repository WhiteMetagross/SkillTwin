{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skilltwin.io/schemas/checkpointResult.schema.json",
  "title": "CheckpointResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkpointId",
    "sessionId",
    "stepId",
    "verdict",
    "confidence",
    "observed",
    "missing",
    "message",
    "correction"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "checkpointId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "stepId": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "uncertain"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "observed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "message": {
      "type": "string"
    },
    "correction": {
      "type": ["string", "null"]
    }
  }
}
