{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skilltwin.io/schemas/jobStatus.schema.json",
  "title": "JobStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "skillId",
    "status",
    "stage",
    "progressPercent",
    "message",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "skillId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "reviewRequired", "completed", "failed"]
    },
    "stage": {
      "type": "string",
      "enum": [
        "uploading",
        "analyzingMedia",
        "extractingDocuments",
        "composingSkill",
        "checkingPolicy",
        "readyForReview",
        "publishing"
      ]
    },
    "progressPercent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "message": {
      "type": "string"
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
