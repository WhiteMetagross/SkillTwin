{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skilltwin.io/schemas/checkpointRequest.schema.json",
  "title": "CheckpointRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "stepId", "checkpointImageKey"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "stepId": {
      "type": "string",
      "minLength": 1
    },
    "checkpointImageKey": {
      "type": "string",
      "minLength": 1
    }
  }
}
